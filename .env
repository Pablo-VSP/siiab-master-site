# =============================================================================
# .env — valores por defecto (base) para todos los entornos.
#
# Next.js carga los archivos en este orden de precedencia (mayor gana):
#   .env.$(NODE_ENV).local  >  .env.local  >  .env.$(NODE_ENV)  >  .env
#
# Aquí van solo valores neutros/seguros que sirven como respaldo. Los valores
# reales por entorno viven en .env.dev (Cloud Run DEV) y .env.local (local).
#
# NOTA: estas variables se leen en el SERVIDOR (lib/services/*.ts). No llevan
# prefijo NEXT_PUBLIC_ porque no deben exponerse al navegador.
# =============================================================================

# URLs de los servicios backend. Se sobreescriben por entorno.
GATEKEEPER_URL=http://localhost:3001
KEYMASTER_URL=http://localhost:3002
