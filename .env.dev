# =============================================================================
# .env.dev — entorno DEV desplegado en Cloud Run.
#
# Apunta a los servicios Gatekeeper/Keymaster desplegados en Cloud Run (DEV).
# En el despliegue real, estas mismas variables se pasan como env vars del
# servicio (ver build-dev.yaml, paso "deploy"). Este archivo sirve de
# referencia y para pruebas locales contra los backends de DEV.
#
# Nota: Next carga .env.dev solo cuando NODE_ENV=dev. Para forzar carga local
# contra DEV puedes copiar estos valores a .env.local temporalmente.
# =============================================================================

GATEKEEPER_URL=https://mado-gcp-dev-crn-sivain-uc1-ser-master-gatekeeper-247585041755.us-central1.run.app
KEYMASTER_URL=https://mado-gcp-dev-crn-sivain-uc1-ser-master-keymaster-247585041755.us-central1.run.app
